APP_NAME=AnimeLibrary
DEBUG=true
AUTO_CREATE_TABLES=true
DATABASE_URL=postgresql+asyncpg://anime:anime@localhost:5432/anime_together
REDIS_URL=redis://localhost:6379/0
ANILIST_API_URL=https://graphql.anilist.co
ANILIBRIA_ENABLED=true
ANILIBRIA_API_URL=https://anilibria.top/api/v1
ANILIBRIA_SYNC_TTL_SECONDS=21600
ANILIBRIA_MAX_RESULTS=10
ANILIBRIA_PREFERRED_QUALITY=1080
ANILIBRIA_HLS_HOST_SUFFIXES=libria.fun,anilibria.top
KODIK_API_URL=https://kodikapi.com
KODIK_TOKEN=
KODIK_PLAYER_ORIGINS=https://kodik.info
KODIK_SYNC_TTL_SECONDS=21600
KODIK_MAX_TRANSLATIONS=8
ADMIN_API_KEY=replace-with-a-long-random-secret
SESSION_COOKIE_SECURE=false
SESSION_DURATION_DAYS=30
CORS_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000"]
